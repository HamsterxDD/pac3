"VertexlitGeneric"
{
	"$basetexture" "https://github.com/HamsterxDD/pac3/raw/refs/heads/main/cloth3.vtf"
	"$bumpmap" "https://github.com/HamsterxDD/pac3/blob/main/cloth3_n.vtf"

	$phong 1
  	$phongfresnelranges "[0.5 0.75 1]"
    	$phongtint "[0.6 0.6 0.6]"
	$phongexponent 6
	$phongboost .2
	$alphatest 1
	$allowalphatocoverage 1

	"$envmapcontrast" 1
	"$envmapsaturation" 1
	"$nocull" 1
	"$nodecal" 1

	$bumpmapalphaphongmask        1

}

